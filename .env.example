# Copy to .env and fill in your credentials. (.env is gitignored)

# Supabase / PostgREST (server-side only; never exposed to browser)
SUPABASE_URL=https://your-project.supabase.co
SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL & Session Secret (any random 32+ char string)
APP_URL=http://localhost:3006
SESSION_SECRET=change-me-to-a-long-random-secret-string

# Optional: Claude API Key (for generating new curriculum packs & AI cards)
ANTHROPIC_API_KEY=

# Optional: Image API Keys (falls back automatically to Wikipedia / Wikimedia Commons if empty)
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Optional: Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
